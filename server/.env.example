PORT=3001
APP_ORIGIN=http://localhost:5173
# Without DATABASE_URL, local development uses SQLite.
# For Supabase: Connect -> Session pooler (port 5432). Replace the password
# placeholder with your URL-encoded database password; keep this server-only.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_SSL=true
# Optional: Supabase CA certificate PEM if your TLS connection needs it.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Optional one-time import of existing SQLite accounts and documents:
# SQLITE_IMPORT_PATH=/absolute/path/to/server/data/linkfolio.sqlite
# DATABASE_PATH=./data/linkfolio.sqlite
# NODE_ENV=production
# Demo checkout is available only outside production, when Stripe is not set.
DEMO_PAYMENTS=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Linkfolio <noreply@example.com>
# For npm run admin; set your own credentials, never use a default password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Optional AI-assisted resume parsing (users choose it explicitly in the import dialog).
# OPENAI_API_KEY=
# RESUME_IMPORT_MODEL=gpt-4.1-mini
