{
  "name": "linkfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "install:all": "npm --prefix server ci && npm --prefix client ci --include=dev",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "lint": "npm --prefix client run lint && node client/node_modules/eslint/bin/eslint.js server shared scripts eslint.config.mjs --max-warnings=0",
    "admin": "npm --prefix server run admin",
    "test:e2e": "npm --prefix client run test:e2e --",
    "db:check": "npm --prefix server run db:check",
    "db:normalize": "npm --prefix server run db:normalize --",
    "db:import": "npm --prefix server run db:import"
  }
}
